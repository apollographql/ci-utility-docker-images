{
  extends: [
    'github>apollographql/renovate-config-apollo-open-source:default.json5',
  ],
  minimumReleaseAge: '3 days',
  packageRules: [
    {
      matchFileNames: [
        '/(^|/)Dockerfile$/',
        '/(^|/)Dockerfile\\.[^/]*$/'
      ],
      matchUpdateTypes: [
        'major'
      ],
      enabled: false
    },
    {
      matchManagers: [
        'github-actions'
      ],
      digest: {
        groupName: 'GitHub Actions Digests',
        groupSlug: 'gha-digests'
      }
    },
    {
      matchFileNames: [
        '/(^|/)Dockerfile$/',
        '/(^|/)Dockerfile\\.[^/]*$/'
      ],
      automerge: true
    },
    {
      matchPackageNames: [
        'jonathanrainer/ghafmt',
        'ghcr.io/jonathanrainer/ghafmt',
      ],
      groupName: 'ghafmt',
      groupSlug: 'ghafmt',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Dockerfile$/',
        '/(^|/)Dockerfile\\.[^/]*$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))?(?: extractVersion=(?<extractVersion>.*))?(?:^|\\r\\n|\\r|\\n|$)(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)(?:^|\\r\\n|\\r|\\n|$)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)lefthook\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+run:[^\\n]*?:(?<currentValue>\\d+\\.\\d+\\.\\d+[^\\s\\\'"]*)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+version:\\s*[\\\'"]?(?<currentValue>[^\\s\\\'"]+)',
      ],
    },
  ],
  schedule: [
    '* * * * * *',
  ],
  updateNotScheduled: true,
}
